# Copy this file to .env (git-ignored) for local runs. Never commit real values.
# In CI these same names are read from GitHub repo secrets instead (see the workflow).

EVINCED_JFROG_TOKEN=
EVINCED_SERVICE_ID=
EVINCED_API_KEY=
# Optional: only needed if you use offline/JWT auth instead of an API key
EVINCED_AUTH_TOKEN=
