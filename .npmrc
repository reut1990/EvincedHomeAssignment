# Evinced private package registry (JFrog Artifactory).
# Scope @evinced resolves against Evinced's restricted npm registry instead of the
# public npm registry.
@evinced:registry=https://evinced.jfrog.io/artifactory/api/npm/restricted-npm/

# Auth token is read from an environment variable at install time so the real
# secret never gets committed to source control.
#   Local dev:  export EVINCED_JFROG_TOKEN="<your JFrog JWT>"
#   CI:         set the EVINCED_JFROG_TOKEN repo secret (see .github/workflows/playwright.yml)
//evinced.jfrog.io/artifactory/api/npm/restricted-npm/:_authToken=${EVINCED_JFROG_TOKEN}
